---
import Monogram from "./Monogram.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { withBase, withoutBase } from "../lib/paths";
// The base running order agrees with the cube menu; To adds contextual thought links.
const links = [
  { href: "/work", label: "Now / Work" },
  { href: "/writing", label: "Writing" },
  { href: "/reading", label: "Reading" },
  { href: "/to", label: "To" },
  { href: "/modelling", label: "Modelling" },
  { href: "/about", label: "About" },
];
const path = withoutBase(Astro.url.pathname);
const showThoughts = path.replace(/\/+$/, "") === "/to";
const isActive = (href: string) => path.startsWith(href);
const deferUntilHomeImageHidden = path === "/";
const wrap = deferUntilHomeImageHidden ? "fixed inset-x-0 top-0 z-50 bg-transparent" : "sticky top-0 z-50 bg-transparent";
---
<header class:list={[wrap, "site-header w-full"]} data-deferred-header={deferUntilHomeImageHidden ? "home-photo" : undefined}>
  <div class="mx-auto w-[calc(100%-2rem)] max-w-topbar pt-2 pb-0 sm:w-[calc(100%-3rem)] sm:pt-3 sm:pb-0">
    <div class:list={["glass-topbar flex min-w-0 items-center justify-between gap-3 px-4 py-2 sm:justify-normal sm:gap-7 sm:px-5", showThoughts && "flex-wrap xl:flex-nowrap"]}>
      <div class="flex min-w-0 items-center gap-4 sm:mr-auto sm:gap-5">
        <Monogram size="1.45rem" />
        <a
          href={withBase("/iyal")}
          aria-label="iyal, Sundharesan's research into the rural economy"
          title="iyal, research into the rural economy"
          aria-current={isActive("/iyal") ? "page" : undefined}
          class="mm-iyal font-script text-statement font-bold leading-none text-accent transition-colors hover:text-accent-hover"
        >iyal</a>
      </div>
      <nav aria-label="Primary" class:list={["hidden items-center whitespace-nowrap", showThoughts ? "gap-5 xl:flex" : "gap-7 sm:flex"]}>
        {links.map((l) => (
          <Fragment>
          <a href={withBase(l.href)} aria-current={isActive(l.href) ? "page" : undefined}
             class:list={["text-xs font-semibold uppercase tracking-kicker transition-colors u-draw", isActive(l.href) ? "text-accent hover:text-accent-hover" : "text-text-muted hover:text-text"]}>{l.label}</a>
          {showThoughts && l.href === "/to" && (
            <span data-to-thoughts class="flex items-center gap-4 text-sm font-semibold">
              <a href={withBase("/kalai")} class="thought-link-kalai u-draw">Kalai</a>
              <a href={withBase("/vilai")} class="thought-link-vilai u-draw">Vilai</a>
            </span>
          )}
          </Fragment>
        ))}
      </nav>
      <div class="flex shrink-0 items-center gap-2 sm:gap-3">
        <ThemeToggle />
        <button id="cube-trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="cube-menu" aria-label="Open menu" class="rounded-md border border-border p-2 text-text-muted transition-colors hover:text-text">
          <span class="hb" aria-hidden="true"><span class="hb-l hb-1"></span><span class="hb-l hb-2"></span><span class="hb-l hb-3"></span></span>
        </button>
      </div>
      {showThoughts && (
        <nav aria-label="To and open thoughts" data-to-thoughts class="flex w-full items-center justify-center gap-6 border-t border-border py-2 text-sm font-semibold xl:hidden">
          <a href={withBase("/to")} aria-current="page" class="u-draw text-accent">To</a>
          <a href={withBase("/kalai")} class="thought-link-kalai u-draw">Kalai</a>
          <a href={withBase("/vilai")} class="thought-link-vilai u-draw">Vilai</a>
        </nav>
      )}
    </div>
  </div>
</header>
{deferUntilHomeImageHidden && (
  <script>
    const header = document.querySelector("[data-deferred-header='home-photo']");

    function initDeferredHeader() {
      if (!(header instanceof HTMLElement)) return;

      let ticking = false;
      const update = () => {
        const photo = document.querySelector("[data-home-photo-frame]");
        const shouldShow = !(photo instanceof HTMLElement) || photo.getBoundingClientRect().bottom <= 0;
        header.classList.toggle("is-visible", shouldShow);
        ticking = false;
      };

      header.classList.add("is-deferred-ready");
      update();
      window.addEventListener("scroll", () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }, { passive: true });
      window.addEventListener("resize", update, { passive: true });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initDeferredHeader, { once: true });
    } else {
      initDeferredHeader();
    }
  </script>
)}
