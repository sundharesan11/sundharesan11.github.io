---
import PageHeader from "./PageHeader.astro";
import { withBase } from "../lib/paths";
const ambitions = [
  {
    href: "/to/agri-fintech",
    tag: "A parked bet",
    title: "Season Trust",
    dek: "Outside money into farm seasons. Parked while iyal works out whether the margin can carry it.",
  },
  {
    href: "/to/sports-development",
    tag: "A lifetime's work",
    title: "The Long Game",
    dek: "A billion people, a handful of medals. Finding the talent the system never sees, and building the ladder it never had.",
  },
  {
    href: "/to/waste-management",
    tag: "A civic layer",
    title: "The Civic Loop",
    dek: "The invisible infrastructure of clean cities: boring when it works, impossible to ignore when it doesn't.",
  },
];
---
<main id="main-content" class="mx-auto max-w-page px-6 pt-16 pb-16">
  <PageHeader left="The future desk" right="Forming">
    <div class="mt-5 flex min-w-0 items-end gap-5">
      <h1 data-reveal class="reveal-scale display-fit font-serif text-display-hero font-semibold leading-[0.78]">To</h1>
      <span class="mb-[0.7rem] h-px min-w-[2rem] flex-1 bg-stellar"></span>
    </div>
    <p data-reveal class="display-fit mt-8 max-w-[22ch] font-serif text-statement font-semibold leading-[1.05]">Things I intend to build. All of them.</p>
  </PageHeader>

  <section aria-label="Two open thoughts" class="mt-10 border-t border-border pt-8">
    <p class="text-dek text-text-muted">Two thoughts with a little room of their own.</p>
    <div class="mt-6 grid gap-8 sm:grid-cols-2">
      <a href={withBase("/kalai")} class="thought-link-kalai group block">
        <h2 class="font-sans text-display-name font-semibold leading-none tracking-tight">Kalai <span aria-hidden="true" class="adv-arrow inline-block text-statement">↗</span></h2>
        <p class="mt-3 text-base">On art <span lang="ta">· கலை</span></p>
      </a>
      <a href={withBase("/vilai")} class="thought-link-vilai group block">
        <h2 class="font-sans text-display-name font-semibold leading-none tracking-tight">Vilai <span aria-hidden="true" class="adv-arrow inline-block text-statement">↗</span></h2>
        <p class="mt-3 text-base">On sport <span lang="ta">· விளை</span></p>
      </a>
    </div>
  </section>

  <section class="mt-14">
    {ambitions.map((a) => (
      <article class="group border-t border-border py-10">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <a href={withBase(a.href)} class="transition-colors hover:text-accent">
            <h2 class="swap-italic display-fit font-serif text-entry font-semibold leading-[1.0]">
              <span class="si-roman">{a.title}</span>
              <span class="si-italic" aria-hidden="true">{a.title}</span>
            </h2>
          </a>
          <span class="label-fit font-sans text-xs uppercase tracking-kicker text-accent">{a.tag}</span>
        </div>
        <p class="text-fit mt-3 max-w-[62ch] text-text-muted">{a.dek}</p>
      </article>
    ))}
  </section>
</main>
