---
// src/layouts/BaseLayout.astro
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CubeMenu from "../components/CubeMenu.astro";
import IdleSunflowers from "../components/IdleSunflowers.astro";
import { withBase } from "../lib/paths";

interface Props {
  title: string;
  description?: string;
  showFooter?: boolean;
  noindex?: boolean;
}
const { title, description = "What matters must be lived. A personal website by Sundharesan Kumaresan.", showFooter = true, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://sundharesan11.github.io").href;
const ogImage = new URL(withBase("/og-profile-2026-v2.png"), Astro.site ?? "https://sundharesan11.github.io").href;
const ogImageAlt = "Sundharesan Kumaresan. What matters must be lived.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/icon-2026.png")} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="shortcut icon" href={withBase("/favicon.ico")} />

    <!-- Self-hosted fonts are imported in global.css; until then system stacks render. -->

    <!-- No-flash: set the theme class BEFORE first paint -->
    <script is:inline>
      (() => {
        try {
          const s = localStorage.getItem("theme");
          const el = document.documentElement;
          const t = (s === "light" || s === "dark" || s === "cream") ? s : "light";
          el.classList.toggle("dark", t === "dark");
          el.classList.toggle("theme-cream", t === "cream");
        } catch (_) {}
        // Enter the pre-reveal state before first paint, so titles animate in
        // instead of painting at rest and then jumping. If the motion script
        // never runs, drop the class so content can't stay hidden.
        const root = document.documentElement;
        root.classList.add("js-reveal");
        setTimeout(() => { if (!root.dataset.motion) root.classList.remove("js-reveal"); }, 3000);
      })();
    </script>
  </head>
  <body>
    <div id="scroll-progress" aria-hidden="true"></div>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-bg focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-accent focus:outline focus:outline-2 focus:outline-accent"
    >Skip to main content</a>
    <Header />
    <slot />
    {showFooter && <Footer />}
    <CubeMenu />
    <IdleSunflowers />
    <script>
      import { initMotion } from "../scripts/reveal";
      initMotion();
    </script>
  </body>
</html>
